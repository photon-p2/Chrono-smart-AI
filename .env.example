# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/meeting-scheduler
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_chronosmart_2026
REFRESH_TOKEN_SECRET=super_secret_refresh_key_chronosmart_2026

# OAuth Credentials (Google & Outlook)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Nodemailer / Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# External Video Links Integration
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
